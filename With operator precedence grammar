eval2.y
%{
#include <stdio.h>
#include <stdlib.h>

int yylex();
void yyerror(char *s);
%}

%token NUMBER

%%
start:
      expr        { printf("Result = %d\n", $1); }
      ;

expr:
      expr '+' term     { $$ = $1 + $3; }
    | expr '-' term     { $$ = $1 - $3; }
    | term              { $$ = $1; }
    ;

term:
      term '*' factor   { $$ = $1 * $3; }
    | term '/' factor   { $$ = $1 / $3; }
    | factor            { $$ = $1; }
    ;

factor:
      '(' expr ')'      { $$ = $2; }
    | NUMBER            { $$ = $1; }
    ;
%%

void yyerror(char *s)
{
    printf("Invalid Expression\n");
}

int main()
{
    printf("Enter expression: ");
    yyparse();
    return 0;
}
